{
  "main": "index.html",
  "logo": "logo.png",
  "pluginSetting": {
    "height": 540,
    "single": true
  },
  "features": [
    {
      "code": "msgpack-to-json",
      "explain": "将 Hex 格式的 MessagePack 转换为格式化 JSON",
      "cmds": [
        "msgpack-to-json",
        "msg2json",
        "MessagePack 转 JSON",
        {
          "type": "regex",
          "label": "msg2json",
          "match": "/^(?:0x)?(?:[0-9a-f]{2})(?:[\\s,;:_-]*(?:0x)?[0-9a-f]{2})+$/i",
          "minLength": 4,
          "maxLength": 100000
        }
      ]
    }
  ]
}
